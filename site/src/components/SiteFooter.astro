---
import { REPO_URL, STORE_URL, SUPPORT_EMAIL } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="site-footer" aria-label="Site">
  <div class="footer-brand">
    <a class="brand" href={`${base}/`}>
      <img src={`${base}/assets/vecto_logo.png`} alt="" width="24" height="24" /> Vecto
    </a>
  </div>
  <div class="footer-group">
    <h2 class="footer-head">Get Vecto</h2>
    <ul>
      <li><a href={STORE_URL}>Microsoft Store</a></li>
      <li><a href={`${base}/changelog/`}>Changelog</a></li>
      <li><a href={REPO_URL}>Source code on GitHub</a></li>
    </ul>
  </div>
  <div class="footer-group">
    <h2 class="footer-head">Help</h2>
    <ul>
      <li><a href={`mailto:${SUPPORT_EMAIL}`}>Support</a></li>
      <li><a href={`${base}/privacy/`}>Privacy</a></li>
    </ul>
  </div>
  <div class="footer-group">
    <h2 class="footer-head">About</h2>
    <ul>
      <li>Made by <a href="https://damt.xyz">damt.xyz</a></li>
      <li>© 2026 damt.xyz</li>
    </ul>
  </div>
</footer>

<style>
  * { box-sizing: border-box; }
  .site-footer {
    display: grid; gap: 1.5rem 2rem;
    grid-template-columns: minmax(160px, 1.4fr) repeat(3, minmax(140px, 1fr));
    border-top: 1px solid #232323; background: #0a0a0a;
    padding: 2rem clamp(16px, 4vw, 64px) 2.5rem;
    color: #a3a3a3; font-size: 0.9rem; line-height: 1.6;
  }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; color: #fff; font-weight: 700; font-size: 1.05rem; text-decoration: none; }
  .brand img { width: 24px; height: 24px; border-radius: 5px; display: block; }
  .footer-head {
    margin: 0 0 0.5rem; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: #8c8c8c;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  a { color: #c9c9c9; text-decoration: none; }
  a:hover { color: #fff; text-decoration: underline; }
  @media (max-width: 720px) {
    .site-footer { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
</style>
