<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vecto.Core\Vecto.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4.x validates the community licence at build time; key: sixlabors.lic in this project dir -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <!-- PDF input: PDFtoImage wraps PDFium (bblanchon non-V8 binaries) and renders to SKBitmap in memory -->
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>vecto</AssemblyName>
    <RootNamespace>Vecto.Cli</RootNamespace>
  </PropertyGroup>

</Project>
